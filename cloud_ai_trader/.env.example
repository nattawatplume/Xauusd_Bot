# Google Gemini API Key (configure billing/quotas at Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Replace with a unique random secret of at least 32 characters.
# Do not use this placeholder value.
BRIDGE_TOKEN=replace_with_a_unique_random_secret_at_least_32_characters

# Server binding
HOST=127.0.0.1
PORT=8766

# Trading Modes
SHADOW_MODE=true
ENABLE_TRADING=false

# LLM model. Check Google's current model lifecycle before upgrading.
LLM_MODEL=gemini-3.6-flash

# Lighter model used when the primary is overloaded or slow.
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
# low | medium | high, or empty for the model default. "low" keeps decisions under the EA timeout.
LLM_THINKING_LEVEL=low
